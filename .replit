modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
ETH_WALLET_ADDRESS = "0x537C4e2bDf98a24461964Af3076447B184A6E9F3"
USDC_WALLET_ADDRESS = "0x537C4e2bDf98a24461964Af3076447B184A6E9F3"
BASE_WALLET_ADDRESS = "0x537C4e2bDf98a24461964Af3076447B184A6E9F3"
SOL_WALLET_ADDRESS = "5SR6fdZTZkboeXD4cFVW8N4jLhWdUdxJbLLaiSKbvdN6"

[nix]
channel = "stable-25_05"
